                            "value": "<!-- Include SweetAlert2 Library -->\r\n<script src=\"https://cdn.jsdelivr.net/npm/sweetalert2@11\"><\/script>\r\n\r\n<script>\r\n    $(document).ready(function () {\r\n        let formErrors = $(\"input[name='_FORM_ERRORS']\").val();\r\n        let formSuccess = document.getElementsByClassName('form-message form-success');\r\n        if (formErrors) {\r\n            try {\r\n                // Parse the error messages from the JSON string\r\n                let errors = JSON.parse(formErrors);\r\n\r\n                if (errors.errors) {\r\n                    // Collect all error messages\r\n                    let errorMessages = Object.values(errors.errors);\r\n\r\n                    // Show SweetAlert popup with validation messages\r\n                    if (errorMessages.length > 0) {\r\n                        Swal.fire({\r\n                            title: 'Erreur lors de la création du compte',\r\n                            html: errorMessages.join('<br>'), // Format messages as HTML\r\n                            icon: 'error',\r\n                            confirmButtonText: 'OK'\r\n                        }).then((result) => {\r\n                            if (result.isConfirmed) {\r\n                                    // Close the SweetAlert popup (default action)\r\n                                    Swal.close(); \r\n                            }\r\n                        });\r\n                    }\r\n                }\r\n            } catch (err) {\r\n                console.error(\"Error parsing _FORM_ERRORS:\", err);\r\n            }\r\n        }else if(formSuccess.length > 0){\r\n            Swal.fire({\r\n                title: 'Votre demande de création de compte a été complétée avec succès.',\r\n                html: 'vous recevrez une notification par mail dès qu\\'elle sera traitée', // Format messages as HTML\r\n                icon: 'success',\r\n                confirmButtonText: 'OK'\r\n            }).then((result) => {\r\n                if (result.isConfirmed) {\r\n                    window.location.href = '/jw/web/login'; // Change to your desired URL\r\n                }\r\n            });\r\n        }\r\n    });\r\n<\/script>\r\n"
