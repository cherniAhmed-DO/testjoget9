                            "permission_rules": {"a9847bf9-02d9-2e91-1282-aad84b16345e": {}},
                            "label": "",
                            "id": "field14",
                            "value": "<script type=\"text/javascript\">\r\n    function resizeIframe(obj) {\r\n         obj.style.height = (obj.contentWindow.document.documentElement.scrollHeight)+30 + 'px';    \r\n    }\r\n    $(document).ready(function(){\r\n       const frameEvals = document.getElementById(\"frameDossier2\");\r\n        frameEvals.src=\"/jw/web/userview/rsu/rsu_userview/_/liste_traitement_dossier_anps?id_organisme=#variable.processID#&embed=true&anps=true\";\r\n    //   frameEvals.addEventListener('mouseout',function(){\r\n    //         // frameEvals.src=\"/jw/web/userview/rsu/rsu_userview/_/demande_commission?id_commission=#variable.processID#&embed=true\";\r\n    //     }) \r\n    });\r\n    \r\n    <\/script>\r\n    <iframe id=\"frameDossier2\" width=\"100%\" height=\"800px\" frameborder=\"0\" onload=\"resizeIframe(this)\" ><\/iframe>\r\n    <style>\r\n        #validator_indiv{\r\n         visibility:hidden;\r\n        }\r\n    <\/style>"
                        }
                    },
                    {
                        "className": "org.joget.apps.form.lib.TextField",
                        "properties": {
                            "requiredSanitize": "",
                            "maxlength": "",
                            "permission_rules": {"a9847bf9-02d9-2e91-1282-aad84b16345e": {}},
                            "validator": {
                                "className": "org.joget.apps.form.lib.BeanShellValidator",
                                "properties": {
                                    "decoration": "",
                                    "script": "\r\n\r\n\r\n\r\nimport java.sql.Connection;\r\nimport java.sql.PreparedStatement;\r\nimport java.sql.ResultSet;\r\nimport java.sql.SQLException;\r\nimport javax.sql.DataSource;\r\nimport org.joget.apps.app.service.AppUtil;\r\nimport org.joget.commons.util.LogUtil;\r\n \r\nimport java.util.Arrays;\r\nimport org.joget.apps.form.model.Element;\r\nimport org.joget.apps.form.model.FormData;\r\nimport org.joget.apps.form.service.FormUtil;\r\nimport org.joget.apps.form.model.Form;\r\nimport javax.servlet.http.HttpServletRequest;\r\nimport org.joget.apps.app.service.AppUtil;\r\n\r\n\r\n\r\n\r\nint dossier=0;\r\nint dossierFixes=0;\r\nString defaultId = \"validator_indiv\";\r\nForm form = FormUtil.findRootForm(element);\r\nElement currentElement = FormUtil.findElement(defaultId, form, formData);\r\nString currentElementId = currentElement.getCustomParameterName();\r\nif (currentElementId==null){\r\n    currentElementId = defaultId;\r\n}\r\n\r\nConnection con = null;\r\ntry {\r\n    // retrieve connection from the default datasource\r\n    DataSource ds = (DataSource)AppUtil.getApplicationContext().getBean(\"setupDataSource\");\r\n    con = ds.getConnection();\r\n    // execute SQL query\r\n    if(!con.isClosed()) {\r\n        PreparedStatement selectOrganismeTreated = con.prepareStatement(\"select count(*) from app_fd_indiv_org where c_id_demande_organisme=? and c_tovalidate='oui' and c_traiter_anps is null;\");\r\n        selectOrganismeTreated.setString(1,\"#variable.processID#\");\r\n        \r\n        ResultSet rs2 = selectOrganismeTreated.executeQuery();\r\n        while (rs2.next()) {\r\n            try {\r\n                dossierFixes = Integer.parseInt(rs2.getString(1));\r\n            }catch(Exception e){\r\n                Logutil.error(\"-------- Error parsing count dossier -------->\",e,\"Error parsing\");\r\n            }\r\n        }\r\n    }\r\n \r\n} catch(Exception e) {\r\n    LogUtil.error(\"error getting validators organisme treatement dossier \", e, \"error SQL validator\");\r\n} finally {\r\n    try {\r\n        if(con != null) {\r\n            con.close();\r\n        }\r\n    } catch(SQLException e) {/* ignored */}\r\n}\r\n \r\n\r\n\r\n    if(dossierFixes>0){\r\n        formData.addFormError(currentElementId,\"vous devez traiter tous les dossiers avant de valider !\");\r\n        return false;\r\n    }else{\r\n        return true ;\r\n    }\r\n\r\n\r\n"
                                }
                            },
