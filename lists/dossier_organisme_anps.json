            "querySource": "sql",
            "pagination": "",
            "debug": "true",
            "sql": "select p.c_identind,p.c_identmen,p.c_numero_npi,p.c_hl2a,p.c_hl2b,indorg.id,p.c_hl5m,p.c_hl5y,p.id as \"id_indiv\",indorg.c_traiter_anps from app_fd_dossier_organisme dc\r\njoin\r\napp_fd_table_individus p on (p.id=dc.c_id_dossier)\r\njoin \r\napp_fd_indiv_org indorg on (indorg.c_id_indiv=p.id)\r\nwhere dc.c_id_organisme = '#requestParam.id_organisme#' and indorg.c_tovalidate='oui'",
            "primaryKey": "id"
        }
