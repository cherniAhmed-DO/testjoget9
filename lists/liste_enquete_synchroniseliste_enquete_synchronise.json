    "binder": {
        "className": "org.melkart.plugin.JdbcDatalistBinder",
        "properties": {
            "querySource": "sql",
            "pagination": "true",
            "debug": "",
            "sql": "SELECT \r\n\tpmt.id,\r\n    pmt.c_compagne_enquete AS \"Campagne d'enquêtes\",\r\n    pmt.c_menage_existe AS \"Ménage existe\",\r\n    pmt.c_npi_preinscription AS \"NPI du représentant du ménage\",\r\n    pmt.c_npi_inexistant AS \"NPI inexistant\",\r\n\tplanif.c_chef_equipe AS \"Chef d'équipe\",\r\n\tplanif.c_equipe_enquete AS \"Equipe d'enquete\"\r\nFROM app_fd_pmt pmt\r\njoin app_fd_planif_enquete planif on (pmt.c_compagne_enquete=planif.c_compagne_enquete)\r\nwhere pmt.c_process_started is null\r\nUNION \r\nSELECT \r\n\tpmt.id,\r\n    pmt.c_compagne_enquete AS \"Campagne d'enquêtes\",\r\n    pmt.c_menage_existe AS \"Ménage existe\",\r\n    pmt.c_npi_preinscription AS \"NPI du représentant du ménage\",\r\n    pmt.c_npi_inexistant AS \"NPI inexistant\",\r\n\t'ZAR' AS \"Chef d'équipe\",\r\n\t'ZAR' AS \"Equipe d'enquete\"\r\nFROM app_fd_pmt pmt \r\nwhere ( c_compagne_enquete like ('%zar%') or c_compagne_enquete like ('%ZAR%') ) and pmt.c_process_started is null\r\n",
            "primaryKey": "id"
        }
    },
